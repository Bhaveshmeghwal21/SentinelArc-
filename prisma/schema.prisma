generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REVIEWER
}

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionType {
  SOFT_FLAG
  HARD_BLOCK
  CRISIS_ROUTE
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum ReviewOutcome {
  TRUE_POSITIVE
  FALSE_POSITIVE
  ESCALATE
}

// B2B customer organization
model Client {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  planTier  PlanTier @default(FREE) @map("plan_tier")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  apiKeys           ApiKey[]
  conversations     Conversation[]
  flags             Flag[]
  actions           Action[]
  crisisRouteEvents CrisisRouteEvent[]
  reviewItems       ReviewItem[]
  auditLogEntries   AuditLogEntry[]
  labeledDataEntries LabeledDataEntry[]
  billingUsages     BillingUsage[]

  @@map("clients")
}

// Team members with dashboard access
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String   @map("password_hash")
  role           UserRole @default(REVIEWER)
  clientId       String   @map("client_id")
  emailVerified  DateTime? @map("email_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewItems     ReviewItem[]
  reviewDecisions ReviewDecision[]

  @@index([clientId])
  @@map("users")
}

// API keys for B2B client ingestion
model ApiKey {
  id        String   @id @default(cuid())
  name      String
  prefix    String   @unique
  keyHash   String   @unique @map("key_hash")
  clientId  String   @map("client_id")
  lastUsed  DateTime? @map("last_used")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([prefix])
  @@map("api_keys")
}

// Conversation with an end user
model Conversation {
  id          String   @id @default(cuid())
  externalId  String   @map("external_id")
  endUserId   String   @map("end_user_id")
  clientId    String   @map("client_id")
  startedAt   DateTime @default(now()) @map("started_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt   DateTime @default(now()) @map("created_at")

  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  turns     ConversationTurn[]
  arcScores ArcScore[]
  flags     Flag[]

  @@unique([clientId, externalId])
  @@index([clientId])
  @@index([endUserId])
  @@map("conversations")
}

// Individual message in a conversation
model ConversationTurn {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // 'user' | 'companion'
  content        String
  timestamp      DateTime
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnScores   TurnScore[]
  flags        Flag[]

  @@index([conversationId])
  @@index([timestamp])
  @@map("conversation_turns")
}

// Per-turn scoring across safety categories
model TurnScore {
  id                  String @id @default(cuid())
  turnId              String @map("turn_id")
  selfHarm            Float  @default(0) @map("self_harm")
  sexualContent       Float  @default(0) @map("sexual_content")
  ageSignal           Float  @default(0) @map("age_signal")
  emotionalIntensity  Float  @default(0) @map("emotional_intensity")
  dependencyLanguage  Float  @default(0) @map("dependency_language")
  romanticEscalation  Float  @default(0) @map("romantic_escalation")
  createdAt           DateTime @default(now()) @map("created_at")

  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@map("turn_scores")
}

// Rolling conversation-level scores with trend indicators
model ArcScore {
  id                  String @id @default(cuid())
  conversationId      String @map("conversation_id")
  selfHarm            Float  @default(0) @map("self_harm")
  sexualContent       Float  @default(0) @map("sexual_content")
  ageSignal           Float  @default(0) @map("age_signal")
  emotionalIntensity  Float  @default(0) @map("emotional_intensity")
  dependencyLanguage  Float  @default(0) @map("dependency_language")
  romanticEscalation  Float  @default(0) @map("romantic_escalation")
  trendDirection      String @default("stable") @map("trend_direction") // rising, falling, stable
  turnCount           Int    @default(0) @map("turn_count")
  createdAt           DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("arc_scores")
}

// Flags raised on turns or conversations
model Flag {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  turnId         String?      @map("turn_id")
  clientId       String       @map("client_id")
  category       String       // e.g. 'self_harm', 'sexual_content'
  severity       FlagSeverity
  score          Float
  threshold      Float
  message        String?
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         ConversationTurn? @relation(fields: [turnId], references: [id], onDelete: SetNull)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actions      Action[]
  reviewItems  ReviewItem[]

  @@index([clientId])
  @@index([conversationId])
  @@index([severity])
  @@map("flags")
}

// Actions taken in response to flags
model Action {
  id        String     @id @default(cuid())
  flagId    String     @map("flag_id")
  clientId  String     @map("client_id")
  type      ActionType
  metadata  Json?
  createdAt DateTime   @default(now()) @map("created_at")

  flag   Flag   @relation(fields: [flagId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([flagId])
  @@map("actions")
}

// Crisis routing events
model CrisisRouteEvent {
  id           String  @id @default(cuid())
  clientId     String  @map("client_id")
  conversationId String @map("conversation_id")
  resourceShown String @map("resource_shown")
  latencyMs    Int     @map("latency_ms")
  success      Boolean
  createdAt    DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("crisis_route_events")
}

// Items queued for human review
model ReviewItem {
  id         String       @id @default(cuid())
  flagId     String       @map("flag_id")
  clientId   String       @map("client_id")
  assigneeId String?      @map("assignee_id")
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  flag      Flag              @relation(fields: [flagId], references: [id], onDelete: Cascade)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee  User?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  decisions ReviewDecision[]

  @@index([clientId])
  @@index([status])
  @@index([assigneeId])
  @@map("review_items")
}

// Review decisions made by reviewers
model ReviewDecision {
  id           String        @id @default(cuid())
  reviewItemId String        @map("review_item_id")
  reviewerId   String        @map("reviewer_id")
  outcome      ReviewOutcome
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")

  reviewItem ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewItemId])
  @@index([reviewerId])
  @@map("review_decisions")
}

// Immutable audit log for all state changes
model AuditLogEntry {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  actor     String   // user ID or 'system'
  action    String   // e.g. 'flag.created', 'review.resolved'
  resource  String   // e.g. 'flag:abc123'
  payload   Json?
  timestamp DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([timestamp])
  @@index([action])
  @@map("audit_log_entries")
}

// Labeled data entries for model improvement
model LabeledDataEntry {
  id              String   @id @default(cuid())
  clientId        String   @map("client_id")
  turnContent     String   @map("turn_content")
  scoresAtFlag    Json     @map("scores_at_flag")
  reviewerDecision String  @map("reviewer_decision")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("labeled_data_entries")
}

// Billing usage tracking per client
model BillingUsage {
  id                String   @id @default(cuid())
  clientId          String   @map("client_id")
  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  conversationCount Int      @default(0) @map("conversation_count")
  turnCount         Int      @default(0) @map("turn_count")
  createdAt         DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([periodStart, periodEnd])
  @@map("billing_usages")
}
