# =============================================================================
# SentinelArc Environment Variables
# =============================================================================
# TEMPLATE ONLY - This file contains no real secrets or credentials.
# Copy this file to .env and fill in the values for your environment.

# --- Database ---
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://user:password@localhost:5432/sentinelarc?schema=public"

# --- Authentication (NextAuth.js) ---
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Base URL of the application (used for callback URLs)
NEXTAUTH_URL="http://localhost:3000"

# --- Redis (BullMQ) ---
# Redis connection string for the scoring job queue
REDIS_URL="redis://localhost:6379"

# --- Stripe (Billing) ---
# Stripe secret key for server-side API calls
STRIPE_SECRET_KEY="sk_test_..."

# Stripe webhook signing secret for verifying webhook payloads
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- AI/Moderation (Optional in v1) ---
# OpenAI API key for the moderation API endpoint
# In v1, pattern-based scoring works without this key.
# Set this to enable enhanced scoring via the OpenAI Moderation API.
OPENAI_API_KEY=""

# --- Logging ---
# Minimum log level: debug, info, warn, error, critical
LOG_LEVEL="info"

# --- Alerting (Optional) ---
# Webhook URL for real-time alert notifications (e.g., Slack, PagerDuty, custom endpoint)
# Leave empty to rely on structured log output only (picked up by Datadog/etc.)
ALERT_WEBHOOK_URL=""
